
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  MANAGER
  SECURITY
  MAINTENANCE
  TENANT
  AUDITOR
}

enum DeviceCategory {
  SMART_LOCK
  DOOR_SENSOR
  GATEWAY
  CONTROLLER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  ERROR
  MAINTENANCE
}

enum EventType {
  ACCESS_GRANTED
  ACCESS_DENIED
  DOOR_LOCKED
  DOOR_UNLOCKED
  DOOR_OPENED
  DOOR_CLOSED
  DOOR_FORCED
  ANOMALY_DETECTED
  SYSTEM_ERROR
}

enum AlertType {
  LOW_BATTERY
  CONNECTION_LOST
  SECURITY_BREACH
  DOOR_LEFT_OPEN
}


model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String?  @map("full_name")
  role         UserRole @default(TENANT)
  isActive     Boolean  @default(true) @map("is_active")
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  managedBuildings Building[]
  accessKeys       AccessKey[]
  eventLogs        EventLog[]

  @@map("users")
}

model Building {
  id          String   @id @default(uuid())
  name        String
  address     String
  description String?
  
  managerId   String?  @map("manager_id")
  manager     User?    @relation(fields: [managerId], references: [id])
  
  rooms       Room[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("buildings")
}

model Room {
  id          String   @id @default(uuid())
  name        String   
  floorNumber Int?     @map("floor_number")
  areaSqm     Float?   @map("area_sqm")
  buildingId  String   @map("building_id")
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  
  devices     Device[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("rooms")
}

model Device {
  id              String         @id @default(uuid())
  serialNumber    String         @unique @map("serial_number")
  name            String?
  category        DeviceCategory @default(SMART_LOCK)
  
  roomId          String         @map("room_id")
  room            Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)

  mqttTopic       String?        @map("mqtt_topic")
  totpSecret      String?        @map("totp_secret")
  
  batteryLevel    Int?           @map("battery_level")
  lastHeartbeat   DateTime?      @map("last_heartbeat")
  status          DeviceStatus   @default(OFFLINE)
  
  config          Json           @default("{}")

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  accessKeys      AccessKey[]
  eventLogs       EventLog[]
  telemetry       Telemetry[]
  alerts          Alert[]

  @@map("devices")
}

model AccessKey {
  id        String   @id @default(uuid())
  validFrom DateTime @map("valid_from")
  validTo   DateTime? @map("valid_to")
  isActive  Boolean  @default(true) @map("is_active")

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId  String   @map("device_id")
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("access_keys")
}

model EventLog {
  id         String    @id @default(uuid())
  eventType  EventType @map("event_type")
  authMethod String?   @map("auth_method")
  timestamp  DateTime  @default(now())
  riskScore  Float     @default(0.0) @map("risk_score")
  
  metadata   Json?

  deviceId   String?   @map("device_id")
  device     Device?   @relation(fields: [deviceId], references: [id])

  userId     String?   @map("user_id")
  user       User?     @relation(fields: [userId], references: [id])

  @@map("event_logs")
}


model Telemetry {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  
  voltage       Decimal? @db.Decimal(5, 2)
  percentage    Int?
  signalQuality Int?     @map("signal_quality")
  
  payload       Json?  

  deviceId      String   @map("device_id")
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("telemetry")
}

model Alert {
  id        String    @id @default(uuid())
  type      AlertType
  message   String
  status    String    @default("NEW")

  deviceId  String    @map("device_id")
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")

  @@map("alerts")
}